{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exocort",
  "version": "0.1.0",
  "identifier": "com.exocort.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": ["../../exocort.png", "icons/icon.icns"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Exocort",
        "width": 1280,
        "height": 980,
        "resizable": true
      }
    ]
  }
}
